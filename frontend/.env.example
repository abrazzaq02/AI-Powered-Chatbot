# Optional. By default the frontend calls "/api" on its own origin and the Vite
# dev server proxies that to the backend (see vite.config.js) — no config needed.
# Set this only if the API lives on a different origin in your deployment.
# VITE_API_URL=https://api.yourdomain.com/api

# Backend target used by the dev-server proxy (defaults to http://127.0.0.1:8000)
# VITE_BACKEND_URL=http://127.0.0.1:8000
