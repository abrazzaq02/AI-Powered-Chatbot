# ---- Security ----
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Database ----
# SQLite by default; swap for postgresql+psycopg://user:pass@host/db in production
DATABASE_URL=sqlite:///./neurochat.db

# ---- CORS ----
# "*" allows any origin (fine for local dev / previews).
# In production set e.g. ALLOWED_ORIGINS=https://yourdomain.com
ALLOWED_ORIGINS=*

# ---- AI provider: option A, local models via Ollama (default) ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ---- AI provider: option B, any OpenAI-compatible API ----
# If OPENAI_API_KEY is set it takes priority over Ollama.
# Works with OpenAI, Groq, Together, OpenRouter, LM Studio, vLLM, ...
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
